    "@vercel/speed-insights": "2.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "clsx": "2.1.1",
    "next": "16.3.6",
    "next-sanity": "13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
