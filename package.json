    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check src",
    "format": "oxfmt src",
    "typecheck": "tsc --project tsconfig.json --noEmit",
