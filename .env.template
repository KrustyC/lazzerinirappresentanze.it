# Copy to .env.local. Every variable is optional: with none set the site
# builds and renders the local copy in src/content/.

# Canonical origin. Falls back to Vercel's production URL, then localhost.
NEXT_PUBLIC_BASE_URL=

# Sanity — see docs/runbooks/sanity.md
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Viewer-role token: draft previews in the Presentation tool.
SANITY_API_READ_TOKEN=
# Editor-role token: only `bun run sanity:seed` uses it. Never set on Vercel.
SANITY_API_WRITE_TOKEN=
# Signs the publish webhook that hits /api/revalidate.
SANITY_WEBHOOK_SECRET=

# Google Tag Manager container (GTM-…). Leave unset: no container loads and
# no tracker mounts. See docs/runbooks/consent-and-tracking.md.
NEXT_PUBLIC_GTM_ID=

# Sentry — inert until the DSNs are set.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time only, for source-map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
